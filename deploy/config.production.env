# Production configuration for gatekeeper (non-secret values only).
#
# This file is committed and copied to the server as `config.env`. The bot
# and migrate containers load it via docker-compose `env_file`.
#
# SECRETS DO NOT BELONG HERE. BOT_TOKEN — and, only when the matching mode
# is `webhook`, TRIBUTE_API_KEY / TELEGRAM_WEBHOOK_SECRET — are injected by
# the deploy workflow from GitHub Actions secrets and override this file.
#
# The deployment-specific values below are intentionally left EMPTY. The
# config loader rejects missing required values ("X is required"), so a
# forgotten edit fails the deploy loudly at startup instead of silently
# running with fake chat IDs or links. Fill them before the first deploy.

# --- Owners (comma-separated positive Telegram user IDs) ---
OWNER_TG_IDS=

# --- Observed sources (chat IDs, form -100XXXXXXXXXX) ---
BOOSTY_GROUP_ID=
TRIBUTE_CHANNEL_ID=

# --- Managed club resources ---
CLUB_CHAT_ID=
CLUB_CHANNEL_ID=
# ADMIN_LOG_CHAT_ID=

# --- Subscribe links (absolute http(s) URLs) ---
BOOSTY_SUBSCRIBE_URL=
TRIBUTE_SUBSCRIBE_URL=

# --- Access granting ---
INVITE_MODE=shared_join_request
INVITE_TTL=24h
ALLOW_DIRECT_INVITES=false
# ADMISSION_FALLBACK_MAX_AGE=1h
# ADMISSION_JOIN_REQUEST_RETRIES=2

# --- Tribute: observation (default) or webhook ---
TRIBUTE_MODE=observation
# TRIBUTE_CANCEL_IS_IMMEDIATE=false
# TRIBUTE_WEBHOOK_PATH=/webhooks/tribute

# --- Telegram transport ---
TELEGRAM_MODE=polling
# TELEGRAM_WEBHOOK_PUBLIC_URL=https://bot.example.com
# TELEGRAM_WEBHOOK_PATH=/webhooks/telegram

# --- Expiry policy ---
EXPIRY_MODE=grace
GRACE_PERIOD=72h
RECONCILE_INTERVAL=1h
CLEANUP_INTERVAL=24h
RAW_RETENTION=720h
AUDIT_RETENTION=8760h
ENFORCER_WORKERS=2

# --- Storage / HTTP / misc ---
DB_PATH=/app/data/gatekeeper.db
TIMEZONE=Europe/Moscow
LOG_LEVEL=info
LOG_FORMAT=json
# Enables the HTTP listener (/healthz, /readyz, /metrics) on :8080.
METRICS_ENABLED=true
WEBHOOK_LISTEN_ADDR=:8080
