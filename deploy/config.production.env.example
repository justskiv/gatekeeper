# Reference for gatekeeper's production configuration keys.
#
# This file is NOT shipped by the deploy workflow. On deploy, config.env
# is rendered on the server from GitHub Environment "Prod" variables
# (non-secret) and container constants, while secrets are injected at
# runtime via compose. Nothing real is committed to this repo.
#
# To run your own instance, set the values below in your GitHub repo:
#
#   # per-deployment, non-secret -> Environment "Prod" variables
#   gh variable set OWNER_TG_IDS --env Prod --body "..."
#   gh variable set CLUB_CHAT_ID --env Prod --body "..."   # etc.
#
#   # secrets -> repository or Environment secrets (never committed)
#   gh secret set BOT_TOKEN --body "..."
#
# Or, for a manual server-resident setup, copy this file to
# /srv/gatekeeper/config.env, fill the values, and skip the render step.

# --- Secrets (GitHub secrets — never put real values in any file) ---
# BOT_TOKEN=                       # required
# TRIBUTE_API_KEY=                 # required only when TRIBUTE_MODE=webhook
# TELEGRAM_WEBHOOK_SECRET=         # required only when TELEGRAM_MODE=webhook

# --- Per-deployment values (GitHub Environment "Prod" variables) ---
OWNER_TG_IDS=               # comma-separated positive Telegram user IDs
BOOSTY_GROUP_ID=            # chat IDs, form -100XXXXXXXXXX
TRIBUTE_CHANNEL_ID=
CLUB_CHAT_ID=
CLUB_CHANNEL_ID=
# ADMIN_LOG_CHAT_ID=
BOOSTY_SUBSCRIBE_URL=       # absolute http(s) URL
TRIBUTE_SUBSCRIBE_URL=
TIMEZONE=Europe/Moscow

# --- Container constants (the deploy workflow writes these) ---
DB_PATH=/app/data/gatekeeper.db
METRICS_ENABLED=true
WEBHOOK_LISTEN_ADDR=:8080

# --- Optional overrides (the app applies these defaults if unset) ---
# INVITE_MODE=shared_join_request
# INVITE_TTL=24h
# ALLOW_DIRECT_INVITES=false
# TRIBUTE_MODE=observation
# TELEGRAM_MODE=polling
# EXPIRY_MODE=grace
# GRACE_PERIOD=72h
# RECONCILE_INTERVAL=1h
# CLEANUP_INTERVAL=24h
# RAW_RETENTION=720h
# AUDIT_RETENTION=8760h
# ENFORCER_WORKERS=2
# LOG_LEVEL=info
# LOG_FORMAT=json
